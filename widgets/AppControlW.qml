             + "                child = None\n"
             + "            if child:\n"
             + "                result.append(child)\n"
             + "        return result\n"
             + "\n"
             + "    def walk(roots, max_nodes=45000):\n"
             + "        stack = list(reversed([item for item in roots if item]))\n"

             + "    atspi.atspi_action_do_action.restype = ctypes.c_int\n"
             + "\n"
             + "    atspi.atspi_init()\n"
             + "    desktop = atspi.atspi_get_desktop(0)\n"
             + "    if not desktop:\n"
             + "        raise RuntimeError(\"AT-SPI desktop is unavailable\")\n"
             + "\n"
             + "    def read_string(pointer):\n"
             + "        if not pointer:\n"
             + "            return \"\"\n"

#!/usr/bin/python3 -I
"""Bounded managed Btrfs swap allocation and boot policy."""
import json
from contextlib import contextmanager
import fcntl
import time
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

GIB = 1024 ** 3
PARENT = Path("/var/lib")
DIRECTORY = PARENT / "post-apollo-memory-swap"
SWAPFILE = DIRECTORY / "swapfile"
EXT_DIRECTORY = PARENT / "post-apollo-memory-extension"
EXT_FILE = EXT_DIRECTORY / "swapfile"
LOCK = Path("/run/post-apollo-memory.lock")
WITHDRAW_MARKER = EXT_DIRECTORY / "withdrawal.json"
REDUCTION_VERSION = 1
ENV = {"PATH": "/usr/sbin:/usr/bin", "LC_ALL": "C"}

def run(*argv):
    return subprocess.run(argv, check=True, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, env=ENV, cwd="/").stdout

def parse_size(value):
    if not re.fullmatch(r"[1-9][0-9]?", value):
        raise ValueError("Choose 4–64 GiB in 4 GiB steps")
    size = int(value)
    if size < 4 or size > 64 or size % 4:
        raise ValueError("Choose 4–64 GiB in 4 GiB steps")
    return size

def secure_parent():
    for path in (Path("/"), Path("/var"), PARENT):
        info = path.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError("Unsafe or unsupported storage parent: " + str(path))

def active_swap(path=SWAPFILE):
    with open("/proc/swaps", encoding="ascii") as stream:
        next(stream)
        for line in stream:
            fields = line.split()
            if len(fields) == 5 and fields[0] == str(path):
                return {"sizeKiB": int(fields[2]), "priority": int(fields[4])}
    return None

def mount_info():
    raw = run("/usr/bin/findmnt", "--json", "--target", str(PARENT), "--output", "TARGET,FSTYPE")
    rows = json.loads(raw).get("filesystems", [])
    if len(rows) != 1 or rows[0].get("target") not in ("/", "/var", "/var/lib"):
        raise RuntimeError("Cannot identify trusted mount for /var/lib")
    return rows[0]["target"], rows[0].get("fstype")

# Separate boot policy: never restart or deactivate existing swap.
UNIT_NAME = r"var-lib-post\x2dapollo\x2dmemory\x2dswap-swapfile.swap"
UNIT_DIR = Path("/etc/systemd/system")
UNIT_PATH = UNIT_DIR / UNIT_NAME
WANTS = UNIT_DIR / "swap.target.wants" / UNIT_NAME
UNIT_CONTENT = (
    "[Unit]\nDescription=Post-Apollo managed NVMe swap\n"
    "ConditionPathExists=/var/lib/post-apollo-memory-swap/swapfile\n"
    "\n[Swap]\nWhat=/var/lib/post-apollo-memory-swap/swapfile\nPriority=10\n"
    "\n[Install]\nWantedBy=swap.target\n"
)

def trusted_unit_directory():
    paths = [Path("/etc"), Path("/etc/systemd"), UNIT_DIR]
    if os.path.lexists(WANTS.parent):
        paths.append(WANTS.parent)
    for path in paths:
        info = path.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError("Unsafe systemd directory: " + str(path))

def trusted_swap_file():
    for path, kind in ((DIRECTORY, stat.S_ISDIR), (SWAPFILE, stat.S_ISREG)):
        info = path.lstat()
        if not kind(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
            raise RuntimeError("Unexpected managed swap ownership or mode")
    if SWAPFILE.stat().st_nlink != 1:
        raise RuntimeError("Unexpected swap hard link")

def persistence_state():
    if not os.path.lexists(UNIT_PATH):
        return "conflict" if os.path.lexists(WANTS) else "off"
    try:
        info = UNIT_PATH.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            return "conflict"
        if UNIT_PATH.read_text(encoding="ascii") != UNIT_CONTENT:
            return "conflict"
        if not os.path.lexists(WANTS):
            return "incomplete"
        if not WANTS.is_symlink() or WANTS.resolve() != UNIT_PATH:
            return "conflict"
        # Confirm systemd recognizes the persistent enablement, not just a file.
        enabled = run("/usr/bin/systemctl", "is-enabled", UNIT_NAME).strip()
        return "enabled" if enabled == "enabled" else "conflict"
    except (OSError, UnicodeError, subprocess.SubprocessError):
        return "unknown"

def persist_authorized():
    if os.geteuid() != 0:
        raise PermissionError("Administrator authentication required")
    secure_parent()
    trusted_unit_directory()
    trusted_swap_file()
    observed = active_swap()
    if not observed or observed["priority"] != 10:
        raise RuntimeError("Activate managed swap at priority 10 first")
    if mount_info()[1] != "btrfs":
        raise RuntimeError("Unexpected swap filesystem")
    expected = run("/usr/bin/systemd-escape", "--path", "--suffix=swap", str(SWAPFILE)).strip()
    if expected != UNIT_NAME:
        raise RuntimeError("Unexpected systemd swap unit identity")
    # Refuse pre-existing fstab management or another unit definition.
    with open("/etc/fstab", encoding="utf-8") as stream:
        if any(line.split("#", 1)[0].split()[:1] == [str(SWAPFILE)] for line in stream):
            raise RuntimeError("Existing fstab entry; no duplicate configuration")
    state = persistence_state()
    if state == "enabled":
        print("VERIFIED PERSISTENCE:", json.dumps({"enabled": True}), flush=True)
        return
    if state != "off":
        raise RuntimeError("Existing or incomplete boot configuration; inspect before recovery")
    if os.path.lexists(UNIT_DIR / (UNIT_NAME + ".d")):
        raise RuntimeError("Existing local swap unit overrides")
    for directory in ("/run/systemd/system", "/usr/lib/systemd/system",
                      "/usr/local/lib/systemd/system", "/run/systemd/generator",
                      "/run/systemd/generator.early", "/run/systemd/generator.late"):
        if (os.path.lexists(Path(directory) / UNIT_NAME)
                or os.path.lexists(Path(directory) / (UNIT_NAME + ".d"))):
            # systemd may synthesize a transient unit from the active kernel swap.
            # No on-disk conflicting unit is accepted.
            raise RuntimeError("Conflicting existing swap unit: " + directory)
    run("/usr/bin/btrfs", "inspect-internal", "map-swapfile", str(SWAPFILE))
    # Publish complete contents atomically, never replace an existing unit.
    import tempfile
    fd, temp = tempfile.mkstemp(prefix=".post-apollo-swap-", dir=UNIT_DIR)
    try:
        with os.fdopen(fd, "w", encoding="ascii") as stream:
            stream.write(UNIT_CONTENT)
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
            os.fsync(stream.fileno())
        os.link(temp, UNIT_PATH)
    finally:
        os.unlink(temp)
    dirfd = os.open(UNIT_DIR, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dirfd)
    finally:
        os.close(dirfd)
    # No --now, no start, no stop: only boot enablement.
    run("/usr/bin/systemctl", "enable", UNIT_NAME)
    if persistence_state() != "enabled":
        raise RuntimeError("Boot enablement not verified; inspect existing configuration")
    if active_swap() != observed:
        raise RuntimeError("Boot policy created but active swap changed; inspect kernel state")
    print("VERIFIED PERSISTENCE:", json.dumps({"enabled": True}), flush=True)

def status():
    secure_parent()
    mountpoint, fs = mount_info()
    usage = os.statvfs(PARENT)
    available = usage.f_bavail * usage.f_frsize
    reserve = max(32 * GIB, (usage.f_blocks * usage.f_frsize + 9) // 10)
    existing = os.path.lexists(DIRECTORY)
    base = active_swap()
    extension = active_swap(EXT_FILE)
    extension_exists = os.path.lexists(EXT_DIRECTORY)
    return {"reductionVersion": REDUCTION_VERSION, "nativeAuthVersion": 1, "persistenceVersion": 1, "persistence": persistence_state(), "filesystem": fs, "mountpoint": mountpoint, "availableGiB": available // GIB,
            "reserveGiB": (reserve + GIB - 1) // GIB,
            "maximumGiB": max(0, min(64, ((available - reserve) // (4 * GIB)) * 4)),
            "existing": existing, "active": base,
            "expansionVersion": 1, "extension": extension, "extensionExists": extension_exists,
            "expansionCandidate": fs == "btrfs" and base is not None and base["priority"] == 10
                and extension is None and not extension_exists,
            "candidate": fs == "btrfs" and not existing and not extension_exists and extension is None,
            "path": str(SWAPFILE)}

def validate_request(size, observed):
    if not observed["candidate"] or size > observed["maximumGiB"]:
        raise RuntimeError("Unsupported filesystem, existing allocation, or insufficient reserved space")

def allocate(size, *, interactive=True):
    if os.geteuid() != 0:
        raise PermissionError("Administrator authentication required")
    if interactive and not sys.stdin.isatty():
        raise RuntimeError("Interactive terminal confirmation required")
    validate_request(size, status())
    print(f"Reserve {size} GiB in {SWAPFILE} (Btrfs /var/lib).", flush=True)
    print("Temporary swap, priority 10. No existing swap will be removed.", flush=True)
    if interactive and input(f"Type ADD {size} to confirm: ") != f"ADD {size}":
        raise RuntimeError("Cancelled; no allocation attempted")
    current = status()
    validate_request(size, current)
    devices = run("/usr/bin/btrfs", "filesystem", "show", "--raw", current["mountpoint"])
    if not re.search(r"\bTotal devices\s+1\b", devices):
        raise RuntimeError("Only single-device Btrfs is supported")
    os.umask(0o077)
    # Atomic refusal if another request has already reserved this path.
    run("/usr/bin/btrfs", "subvolume", "create", str(DIRECTORY))
    DIRECTORY.chmod(0o700)
    run("/usr/bin/btrfs", "filesystem", "mkswapfile", "--size", f"{size}G", str(SWAPFILE))
    SWAPFILE.chmod(0o600)
    run("/usr/bin/btrfs", "inspect-internal", "map-swapfile", str(SWAPFILE))
    run("/usr/sbin/swapon", "--priority", "10", "--", str(SWAPFILE))
    observed = active_swap()
    if not observed or observed["priority"] != 10 or not (
            size * GIB // 1024 - 1024 <= observed["sizeKiB"] <= size * GIB // 1024):
        raise RuntimeError("Activation not verified; inspect swapon --show before recovery")
    print("VERIFIED ACTIVE:", json.dumps(observed), flush=True)

def expansion_delta(target, observed):
    if not isinstance(target, int) or not 4 <= target <= 64 or target % 4:
        raise ValueError("Invalid target capacity")
    if not observed.get("expansionCandidate"):
        raise RuntimeError("Existing extension or missing managed base; inspect before recovery")
    base = observed["active"]["sizeKiB"]
    # Linux excludes its swap header from the reported usable size.
    nominal = (base + 1024) // (4 * GIB // 1024) * 4
    if not 4 <= nominal <= 64 or not 0 <= nominal * GIB // 1024 - base <= 1024:
        raise RuntimeError("Unexpected managed base capacity")
    delta = target - nominal
    if delta < 4 or delta > observed["maximumGiB"]:
        raise RuntimeError("Target must expand the base within storage reserve")
    return delta

def expand_authorized(target):
    if os.geteuid() != 0:
        raise PermissionError("Administrator authentication required")
    secure_parent()
    trusted_swap_file()
    observed = status()
    delta = expansion_delta(target, observed)
    devices = run("/usr/bin/btrfs", "filesystem", "show", "--raw", observed["mountpoint"])
    if not re.search(r"\bTotal devices\s+1\b", devices):
        raise RuntimeError("Only single-device Btrfs is supported")
    # Final check before first mutation; exclusive fixed subvolume creation
    # refuses a second concurrent request. Never modify the original file.
    current = status()
    if expansion_delta(target, current) != delta or current["active"] != observed["active"]:
        raise RuntimeError("Base or available capacity changed")
    os.umask(0o077)
    run("/usr/bin/btrfs", "subvolume", "create", str(EXT_DIRECTORY))
    EXT_DIRECTORY.chmod(0o700)
    run("/usr/bin/btrfs", "filesystem", "mkswapfile", "--size", f"{delta}G", str(EXT_FILE))
    EXT_FILE.chmod(0o600)
    run("/usr/bin/btrfs", "inspect-internal", "map-swapfile", str(EXT_FILE))
    run("/usr/sbin/swapon", "--priority", "9", "--", str(EXT_FILE))
    base = active_swap()
    extra = active_swap(EXT_FILE)
    if base != observed["active"] or not extra or extra["priority"] != 9 or not (
            0 <= delta * GIB // 1024 - extra["sizeKiB"] <= 1024):
        raise RuntimeError("Expansion not verified; inspect kernel state before recovery")
    print("VERIFIED EXPANSION:", json.dumps({"sizeKiB": base["sizeKiB"] + extra["sizeKiB"],
          "basePriority": 10, "extensionPriority": 9, "temporary": True}), flush=True)


class ReductionRecovery(RuntimeError):
    """Durable intent exists; no further withdrawal without reconciliation."""

class ReductionBlocked(RuntimeError):
    def __init__(self, code, evidence=None):
        super().__init__(code)
        self.code = code
        self.evidence = evidence or {}

@contextmanager
def mutation_lock():
    # Shared by all helper mutations; this does not serialize external root tools.
    if os.geteuid() != 0:
        raise PermissionError("Administrator authentication required")
    info = LOCK.parent.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError("Unsafe runtime directory")
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0
                or info.st_mode & 0o077 or info.st_nlink != 1):
            raise RuntimeError("Unsafe operation lock")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise ReductionBlocked("OPERATION_BUSY") from error
        yield
    finally:
        os.close(fd)

def read_reduction_snapshot():
    rows = {}
    with open("/proc/swaps", encoding="ascii") as stream:
        if next(stream, "").split() != ["Filename", "Type", "Size", "Used", "Priority"]:
            raise ValueError("Unexpected swap header")
        for line in stream:
            path, kind, size, used, priority = line.split()
            size, used, priority = int(size), int(used), int(priority)
            if path in rows or kind not in ("file", "partition") or not 0 <= used <= size or size <= 0:
                raise ValueError("Invalid swap row")
            rows[path] = {"kind": kind, "sizeKiB": size, "usedKiB": used, "priority": priority}
    mem = Path("/proc/meminfo").read_text(encoding="ascii")
    psi = Path("/proc/pressure/memory").read_text(encoding="ascii")
    def metric(name):
        matches = re.findall(r"^" + name + r":\s+(\d+)\s+kB\s*$", mem, re.M)
        if len(matches) != 1:
            raise ValueError("Missing or duplicate memory metric")
        return int(matches[0])
    def pressure(name):
        matches = re.findall(r"^" + name + r" avg10=(\d+(?:\.\d+)?) ", psi, re.M)
        if len(matches) != 1 or not 0 <= float(matches[0]) <= 100:
            raise ValueError("Invalid pressure observation")
        return float(matches[0])
    total, available = metric("MemTotal"), metric("MemAvailable")
    if not 0 <= available <= total or total <= 0:
        raise ValueError("Invalid memory capacity")
    return {"rows": rows, "totalKiB": total, "availableKiB": available,
            "someAvg10": pressure("some"), "fullAvg10": pressure("full")}

def nominal_capacity(row):
    size = row["sizeKiB"]
    nominal = (size + 1024) // (4 * GIB // 1024) * 4
    if not 4 <= nominal <= 64 or not 0 <= nominal * GIB // 1024 - size <= 1024:
        raise ReductionBlocked("UNEXPECTED_CAPACITY")
    return nominal

def reduction_plan(target, snapshot):
    """Advisory only; exact base target, unused extension, conservative headroom."""
    rows = snapshot["rows"]
    base, extra = rows.get(str(SWAPFILE)), rows.get(str(EXT_FILE))
    if not base or not extra:
        raise ReductionBlocked("BASE_OR_EXTENSION_INACTIVE")
    if base["kind"] != "file" or extra["kind"] != "file" or base["priority"] != 10 or extra["priority"] != 9:
        raise ReductionBlocked("UNEXPECTED_SWAP_IDENTITY")
    base_gib, extra_gib = nominal_capacity(base), nominal_capacity(extra)
    if base_gib + extra_gib > 64 or target != base_gib:
        raise ReductionBlocked("UNSUPPORTED_TARGET", {"baseGiB": base_gib, "extensionGiB": extra_gib})
    required_ram = max(4 * GIB // 1024, (snapshot["totalKiB"] + 3) // 4)
    # Do not count ZRAM logical free slots as independent physical headroom.
    remaining_base = base["sizeKiB"] - base["usedKiB"]
    evidence = {"targetGiB": target, "baseSizeKiB": base["sizeKiB"],
                "extensionSizeKiB": extra["sizeKiB"], "extensionUsedKiB": extra["usedKiB"],
                "availableKiB": snapshot["availableKiB"], "requiredRamKiB": required_ram,
                "baseFreeKiB": remaining_base, "requiredBaseFreeKiB": 2 * GIB // 1024,
                "someAvg10": snapshot["someAvg10"], "fullAvg10": snapshot["fullAvg10"]}
    if extra["usedKiB"] != 0:
        raise ReductionBlocked("EXTENSION_OCCUPIED", evidence)
    if snapshot["availableKiB"] < required_ram:
        raise ReductionBlocked("RAM_HEADROOM", evidence)
    if remaining_base < evidence["requiredBaseFreeKiB"]:
        raise ReductionBlocked("BASE_HEADROOM", evidence)
    if snapshot["fullAvg10"] != 0 or snapshot["someAvg10"] > 1:
        raise ReductionBlocked("MEMORY_PRESSURE", evidence)
    return evidence

def reduction_preflight(target):
    try:
        evidence = reduction_plan(target, read_reduction_snapshot())
        return {"version": REDUCTION_VERSION, "state": "READY_ADVISORY",
                "code": "FRESH_AUTH_AND_ROOT_CHECK_REQUIRED", "evidence": evidence}
    except ReductionBlocked as error:
        return {"version": REDUCTION_VERSION, "state": "WAITING",
                "code": error.code, "evidence": error.evidence}
    except (OSError, ValueError, KeyError):
        return {"version": REDUCTION_VERSION, "state": "WAITING",
                "code": "OBSERVATION_UNAVAILABLE", "evidence": {}}

def extension_identity():
    secure_parent()
    trusted_swap_file()
    identities = []
    for path, kind in ((DIRECTORY, stat.S_ISDIR), (SWAPFILE, stat.S_ISREG),
                       (EXT_DIRECTORY, stat.S_ISDIR), (EXT_FILE, stat.S_ISREG)):
        info = path.lstat()
        if not kind(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
            raise ReductionBlocked("UNTRUSTED_FILE")
        if kind is stat.S_ISREG and info.st_nlink != 1:
            raise ReductionBlocked("UNTRUSTED_FILE")
        identities.append((info.st_dev, info.st_ino, info.st_size if kind is stat.S_ISREG else 0))
    if mount_info()[1] != "btrfs":
        raise ReductionBlocked("UNSUPPORTED_FILESYSTEM")
    return identities

def check_extension_boot_policy():
    trusted_unit_directory()
    name = run("/usr/bin/systemd-escape", "--path", "--suffix=swap", str(EXT_FILE)).strip()
    expected = r"var-lib-post\x2dapollo\x2dmemory\x2dextension-swapfile.swap"
    if name != expected:
        raise ReductionBlocked("UNEXPECTED_UNIT")
    with open("/etc/fstab", encoding="utf-8") as stream:
        if any(line.split("#", 1)[0].split()[:1] == [str(EXT_FILE)] for line in stream):
            raise ReductionBlocked("EXTENSION_BOOT_POLICY")
    for directory in (UNIT_DIR, UNIT_DIR / "swap.target.wants", Path("/run/systemd/system"),
                      Path("/usr/lib/systemd/system"), Path("/usr/local/lib/systemd/system"),
                      Path("/run/systemd/generator"), Path("/run/systemd/generator.early"),
                      Path("/run/systemd/generator.late"), Path("/run/systemd/transient"),
                      Path("/etc/systemd/system.control"), Path("/run/systemd/system.control")):
        if os.path.lexists(directory / name) or os.path.lexists(directory / (name + ".d")):
            raise ReductionBlocked("EXTENSION_BOOT_POLICY")

def durable_withdrawal_record(data, *, initial=False):
    # Keep the original intent marker forever until an explicit recovery stage.
    # Subsequent outcome is a separate exclusive file, never overwrites intent.
    path = WITHDRAW_MARKER if initial else WITHDRAW_MARKER.with_name("withdrawal-result.json")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="ascii") as stream:
        json.dump(data, stream, sort_keys=True)
        stream.flush()
        os.fsync(stream.fileno())
    fd = os.open(EXT_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)

def withdraw_authorized(target):
    if os.geteuid() != 0:
        raise PermissionError("Administrator authentication required")
    identity = extension_identity()
    if os.path.lexists(WITHDRAW_MARKER) or os.path.lexists(WITHDRAW_MARKER.with_name("withdrawal-result.json")):
        raise ReductionRecovery("RECOVERY_REQUIRED")
    check_extension_boot_policy()
    first = reduction_plan(target, read_reduction_snapshot())
    time.sleep(2)
    if extension_identity() != identity:
        raise ReductionBlocked("FILE_IDENTITY_CHANGED")
    check_extension_boot_policy()
    second = reduction_plan(target, read_reduction_snapshot())
    for key in ("baseSizeKiB", "extensionSizeKiB"):
        if first[key] != second[key]:
            raise ReductionBlocked("CAPACITY_CHANGED")
    record = {"version": REDUCTION_VERSION, "state": "PREPARED", "targetGiB": target,
              "identity": identity, "timeNs": time.time_ns(), "evidence": second}
    try:
        durable_withdrawal_record(record, initial=True)
    except (OSError, ValueError) as error:
        raise ReductionRecovery("INTENT_PUBLICATION_UNVERIFIED") from error
    # Last live check after durable intent. A workload can still race the kernel;
    # never force, delete, retry or assume the call completed on interruption.
    try:
        if extension_identity() != identity:
            raise ReductionBlocked("FILE_IDENTITY_CHANGED")
        final = reduction_plan(target, read_reduction_snapshot())
        if any(final[key] != second[key] for key in ("baseSizeKiB", "extensionSizeKiB")):
            raise ReductionBlocked("CAPACITY_CHANGED")
    except ReductionBlocked as error:
        try:
            durable_withdrawal_record({"state": "NOT_STARTED", "code": error.code})
        except (OSError, ValueError) as write_error:
            raise ReductionRecovery("FINAL_CHECK_RECORD_UNVERIFIED") from write_error
        raise ReductionRecovery("NOT_STARTED_" + error.code) from error
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        raise ReductionRecovery("FINAL_CHECK_UNKNOWN") from error
    try:
        run("/usr/sbin/swapoff", "--", str(EXT_FILE))
        observed = read_reduction_snapshot()["rows"]
        base = observed.get(str(SWAPFILE))
        if (str(EXT_FILE) in observed or not base or base["kind"] != "file"
                or base["priority"] != 10 or base["sizeKiB"] != second["baseSizeKiB"]
                or extension_identity() != identity):
            raise RuntimeError("Withdrawal readback mismatch")
        result = {"version": REDUCTION_VERSION, "state": "VERIFIED", "targetGiB": target,
                  "sizeKiB": base["sizeKiB"], "basePriority": 10,
                  "extensionActive": False, "fileRetained": True, "timeNs": time.time_ns()}
        durable_withdrawal_record(result)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        raise ReductionRecovery("WITHDRAWAL_OUTCOME_UNKNOWN") from error
    print("VERIFIED REDUCTION:", json.dumps(result), flush=True)


def verify_authorized():
    if os.geteuid() != 0:
        raise PermissionError("Administrator authentication required")
    secure_parent()
    observed = active_swap()
    if not observed or observed["priority"] != 10:
        raise RuntimeError("Managed swap is not active at priority 10")
    print("VERIFIED ACTIVE:", json.dumps(observed), flush=True)

def main(args):
    try:
        if args == ["status"]:
            print(json.dumps(status()))
        elif len(args) == 2 and args[0] == "add":
            with mutation_lock():
                allocate(parse_size(args[1]))
        elif len(args) == 2 and args[0] == "add-authorized":
            # pkexec/root authorization is the authority, not UI state.
            with mutation_lock():
                allocate(parse_size(args[1]), interactive=False)
        elif args == ["verify-authorized"]:
            verify_authorized()
        elif args == ["persist-authorized"]:
            with mutation_lock():
                persist_authorized()
        elif len(args) == 2 and args[0] == "expand-authorized":
            with mutation_lock():
                expand_authorized(parse_size(args[1]))
        elif len(args) == 2 and args[0] == "reduction-preflight":
            print(json.dumps(reduction_preflight(parse_size(args[1]))))
        elif len(args) == 2 and args[0] == "withdraw-authorized":
            with mutation_lock():
                withdraw_authorized(parse_size(args[1]))
        else:
            raise ValueError("Usage: status | add GIB | add-authorized GIB | verify-authorized | persist-authorized | expand-authorized GIB | reduction-preflight GIB | withdraw-authorized GIB")
        return 0
    except ReductionRecovery as error:
        print("REDUCTION RECOVERY:", json.dumps({"version": REDUCTION_VERSION, "state": "RECOVERY_REQUIRED", "code": str(error)}), flush=True)
        return 3
    except ReductionBlocked as error:
        print("REDUCTION BLOCKED:", json.dumps({"version": REDUCTION_VERSION, "state": "WAITING", "code": error.code, "evidence": error.evidence}), flush=True)
        return 2
    except (OSError, ValueError, RuntimeError, EOFError, subprocess.SubprocessError) as error:
        print("REFUSED/FAILED:", error, file=sys.stderr)
        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
            print(error.stderr.strip(), file=sys.stderr)
        print("No automatic cleanup or retry. Inspect existing state before recovery.", file=sys.stderr)
        return 1

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

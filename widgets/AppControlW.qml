    function toggleSelectedApplicationMute() {
        if (!selectedResultIsApplication() || !appAudioAvailable)
            return;

        const entry = favoriteSourceItem(selectedResult()) || selectedResult();
        const windows = selectedAppWindows || [];
        if (!entry || windows.length === 0)
            return;

        const shouldMute = !appAudioMuted;

        // App mute is its own policy. Do not create WINDOW policies here;
        // otherwise UNMUTE APP can leave a stale window rule that immediately
        // mutes the same stream again.
        setAppMutePolicy(entry, windows, shouldMute);
        queueAppMuteState(entry, windows, shouldMute);

        // Apply the requested state to every stream already resolved for this
        // application. On unmute this is especially important: removing a
        // policy cannot itself clear PulseAudio's existing mute bit.
        for (let i = 0; i < appAudioSinkInputs.length; i++) {
            Quickshell.execDetached([
                "pactl",
                "set-sink-input-mute",
                String(appAudioSinkInputs[i]),
                shouldMute ? "1" : "0"
            ]);
        }

        appAudioMuted = shouldMute;
        windowAudioPolicyRefreshTimer.restart();
        appAudioRefreshTimer.restart();

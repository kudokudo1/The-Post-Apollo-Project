    Process {
        id: tabAudioProbeProcess

        stdout: StdioCollector {
            onStreamFinished: {
                const entry = appControlWindow.favoriteSourceItem(
                    appControlWindow.selectedResult()
                ) || appControlWindow.selectedResult();

                if (!entry
                        || !appControlWindow.selectedResultIsTab()
                        || appControlWindow.selectedTabAudioKey()
                           !== appControlWindow.tabAudioProbeKey) {
                    appControlWindow.tabAudioSinkInputs = [];
                    appControlWindow.tabAudioAvailable = false;
                    appControlWindow.tabAudioMuted = false;
                    return;
                }

                try {
                    const inputs = JSON.parse(text || "[]");
                    const indexes = [];
                    const matchingInputs = [];
                    let allMuted = true;

                    for (let i = 0; i < inputs.length; i++) {
                        const input = inputs[i];
                        if (!appControlWindow.tabMatchesAudioSink(entry, input))
                            continue;

                        matchingInputs.push(input);
                        const index = Number(input.index);
                        if (!isNaN(index))
                            indexes.push(index);

                        if (!input.mute)
                            allMuted = false;
                    }

                    appControlWindow.tabAudioSinkInputs = indexes;
                    appControlWindow.tabAudioAvailable = true;
                    const probedMuted = indexes.length > 0 && allMuted;
                    appControlWindow.tabAudioMuted = probedMuted;

                    if (appControlWindow.tabAudioMuteVisualOverrideActive
                            && indexes.length > 0
                            && probedMuted
                               === appControlWindow.tabAudioMuteVisualOverrideValue) {
                        appControlWindow.tabAudioMuteVisualOverrideActive = false;
                        tabAudioMuteVisualOverrideTimer.stop();
                    }

                    const desiredVolume =
                        appControlWindow.tabVolumePolicyPercentFor(entry);

                    if (desiredVolume >= 0) {
                        appControlWindow.tabAudioVolumePercent =
                            desiredVolume;
                    } else if (matchingInputs.length > 0) {
                        // Do not flash to the averaged helper's empty-input
                        // fallback (100%) when pactl momentarily publishes no

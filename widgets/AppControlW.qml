             + "            except Exception:\n"
             + "                pass\n"
             + "        return False\n"
             + "\n"
             + "    def normalize(value):\n"
             + "        return \" \".join(str(value or \"\").lower().split())\n"
             + "\n"
             + "    def find_named(\n"
             + "        patterns,\n"
             + "        exact=False,\n"

             + "        return False\n"
             + "\n"
             + "    def open_main_menu():\n"
             + "        patterns = [\n"
             + "            \"Customize and control Brave\",\n"
             + "            \"Brave menu\",\n"
             + "            \"Main menu\",\n"
             + "            \"Customize and control Chromium\",\n"
             + "            \"Customize and control\"\n"
             + "        ]\n"
             + "\n"
             + "        button = find_named(\n"
             + "            patterns,\n"
             + "            exact=False,\n"
             + "            require_action=True,\n"
             + "            search_all=False\n"
             + "        )\n"
             + "\n"
             + "        if not button:\n"
             + "            button = find_named(\n"
             + "                patterns,\n"
             + "                exact=False,\n"
             + "                require_action=True,\n"
             + "                search_all=True\n"
             + "            )\n"
             + "\n"
             + "        if not button:\n"
             + "            return False\n"
             + "\n"
             + "        return invoke(button, [\"click\", \"press\", \"menu\", \"show\"])\n"
             + "\n"
             + "    def reopen_from_tab_context():\n"
             + "        candidates = []\n"
             + "        for obj in walk(brave_roots()):\n"
             + "            if obj_role(obj) != 37:  # ATSPI_ROLE_PAGE_TAB\n"
             + "                continue\n"
             + "            iface, names = action_names(obj)\n"
             + "            if not iface:\n"
             + "                continue\n"
             + "            context_indexes = [\n"
             + "                index\n"
             + "                for index, name in enumerate(names)\n"
             + "                if \"context\" in name or \"menu\" in name\n"
             + "            ]\n"
             + "            if context_indexes:\n"
             + "                candidates.append((obj, iface, context_indexes))\n"
             + "\n"
             + "        for obj, iface, context_indexes in reversed(candidates):\n"
             + "            for index in context_indexes:\n"
             + "                try:\n"
             + "                    if not atspi.atspi_action_do_action(\n"
             + "                        iface,\n"
             + "                        index,\n"
             + "                        None\n"
             + "                    ):\n"
             + "                        continue\n"
             + "                except Exception:\n"
             + "                    continue\n"
             + "\n"
             + "                # Chromium popup menus are often separate AT-SPI roots and can\n"
             + "                # arrive several frames after the context action succeeds.\n"
             + "                # Search the complete desktop and poll instead of only looking\n"
             + "                # inside the Brave application subtree once.\n"
             + "                if wait_click_named(\n"
             + "                    [\"Reopen closed tab\"],\n"
             + "                    exact=False,\n"
             + "                    search_all=True,\n"
             + "                    timeout=2.2\n"
             + "                ):\n"
             + "                    return True\n"
             + "\n"
             + "        return False\n"
             + "\n"
             + "    ok = False\n"
             + "\n"
             + "    if kind == \"restore\":\n"
             + "        ok = reopen_from_tab_context()\n"
             + "\n"
             + "        if not ok and open_main_menu():\n"

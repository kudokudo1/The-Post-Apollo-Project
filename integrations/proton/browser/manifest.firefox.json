{
  "manifest_version": 3,
  "name": "Post-Apollo Proton Companion (Read-Only Pilot)",
  "version": "0.1.0",
  "description": "Opt-in Proton page readiness check after a read-only native handshake; no mailbox data or actions.",
  "browser_specific_settings": {
    "gecko": {
      "id": "postapollo-proton@extensions.invalid"
    }
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "action": {
    "default_title": "Post-Apollo Proton connection check"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}

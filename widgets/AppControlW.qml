    function cancelDestructiveConfirm() {
        if (hunterOperationPhase === "running"
                || hunterOperationPhase === "report") {
            dismissHunterOperationWindow();
            return;
        }

        // A one-shot per-target unlock belongs to this confirmation attempt.
        // Cancelling consumes it too so the original target never remains
        // unexpectedly unlocked after the modal closes.
        const cancelKind = destructiveConfirmKind;
        if (cancelKind === "protected-freeze" || cancelKind === "task-freeze"
                || cancelKind === "protected-term" || cancelKind === "task-term"
                || cancelKind === "protected-restart" || cancelKind === "task-restart") {
            const pid = destructiveConfirmTargetPids.length > 0
                        ? destructiveConfirmTargetPids[0] : 0;
            const entry = taskEntryForCapturedIdentity(
                pid,
                destructiveConfirmTargetName
            );
            if (entry)
                relockTaskDangerAction(
                    entry,
                    cancelKind.indexOf("freeze") !== -1 ? "freeze" : "kill"
                );
        }

        destructiveConfirmOpen = false;
        destructiveConfirmKind = "";
        destructiveConfirmChoice = 0;
        destructiveConfirmTargetPids = [];
        destructiveConfirmTargetName = "";
        hunterPendingTargets = [];
        Qt.callLater(function() { searchInput.forceActiveFocus(); });
    }

    function executeDestructiveConfirm() {
        const kind = destructiveConfirmKind;
        const targetPids = destructiveConfirmTargetPids.slice();
        const targetName = destructiveConfirmTargetName;

        if (kind === "kill-hogs" || kind === "kill-mice") {
            startHunterOperation(kind, hunterPendingTargets.slice());
            return;
        }

        destructiveConfirmOpen = false;
        destructiveConfirmKind = "";
        destructiveConfirmChoice = 0;
        destructiveConfirmTargetPids = [];
        destructiveConfirmTargetName = "";
        hunterPendingTargets = [];

        if (kind === "kill-all")
            executeKillAllEligibleTasks(targetPids);
        else if (kind === "reboot")
            Quickshell.execDetached(["systemctl", "reboot"]);
        else if (kind === "protected-freeze" || kind === "task-freeze")
            executeProtectedTaskSignal(targetPids.length > 0 ? targetPids[0] : 0, targetName, "-STOP");
        else if (kind === "protected-term" || kind === "task-term")
            executeProtectedTaskSignal(targetPids.length > 0 ? targetPids[0] : 0, targetName, "-TERM");
        else if (kind === "protected-restart" || kind === "task-restart")
            executeTaskRestart(targetPids.length > 0 ? targetPids[0] : 0, targetName);
    }

    function systemComponentWarning(entry) {

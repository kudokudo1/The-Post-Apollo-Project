             + "            if \"brave\" in text:\n"
             + "                direct.append(obj)\n"
             + "        return direct if direct else roots\n"
             + "\n"
             + "    def action_names(obj):\n"
             + "        iface = atspi.atspi_accessible_get_action_iface(obj)\n"
             + "        if not iface:\n"
             + "            return None, []\n"

             + "            visited += 1\n"
             + "            yield obj\n"
             + "            kids = children(obj)\n"
             + "            for child in reversed(kids):\n"
             + "                stack.append(child)\n"
             + "\n"
             + "    def root_children():\n"
             + "        return children(desktop)\n"
             + "\n"
             + "    def brave_roots():\n"
             + "        roots = root_children()\n"
             + "        direct = []\n"

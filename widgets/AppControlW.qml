             + "    atspi.atspi_action_get_n_actions.argtypes = [ctypes.c_void_p, ctypes.c_void_p]\n"
             + "    atspi.atspi_action_get_n_actions.restype = ctypes.c_int\n"
             + "    atspi.atspi_action_get_action_name.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p]\n"

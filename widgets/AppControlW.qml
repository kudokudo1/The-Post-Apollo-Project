        const entry = favoriteSourceItem(selectedResult()) || selectedResult();
        if (!entry || entry._tabUnavailable) {
            tabAudioProbeKey = "";
            tabAudioVolumePercent = 100;
            return;
        }

        const nextKey = selectedTabAudioKey();
        const sameTarget = nextKey.length > 0 && nextKey === previousKey;
        tabAudioProbeKey = nextKey;
        tabAudioAvailable = true;

        const desiredVolume = tabVolumePolicyPercentFor(entry);
        if (desiredVolume >= 0)
            tabAudioVolumePercent = desiredVolume;
        else if (!sameTarget)
            tabAudioVolumePercent = 100;

        tabAudioProbeTimer.restart();
    }

    function setSelectedTabVolume(percent) {
        if (!selectedResultIsTab())
            return;

        const entry = favoriteSourceItem(selectedResult()) || selectedResult();
        if (!entry)
            return;

        tabAudioVolumePercent =
            Math.max(0, Math.min(audioVolumeMaxPercent, Number(percent || 0)));

        setTabVolumePolicy(entry, tabAudioVolumePercent);
        setSinkInputVolumes(tabAudioSinkInputs, tabAudioVolumePercent);
        tabAudioRefreshTimer.restart();
    }

    function toggleSelectedTabMute() {
        if (!selectedResultIsTab())
            return false;

        // Mirror the WINDOW mute control immediately. Keep the optimistic
        // visual state while PipeWire/AT-SPI catches up so MUTE TAB always
        // swaps to UNMUTE TAB (icon included) on the click itself.
        const shouldMute = !effectiveTabAudioMuted();
        tabAudioMuted = shouldMute;
        tabAudioMuteVisualOverrideValue = shouldMute;
        tabAudioMuteVisualOverrideActive = true;
        tabAudioMuteVisualOverrideTimer.restart();

        // If there is no live PipeWire stream yet, the caller still falls
        // back to the accessibility action, but the button state has already
        // changed in place.
        if (!tabAudioSinkInputs || tabAudioSinkInputs.length === 0)
            return false;

        for (let i = 0; i < tabAudioSinkInputs.length; i++) {
            Quickshell.execDetached([
                "pactl",
                "set-sink-input-mute",
                String(tabAudioSinkInputs[i]),
                shouldMute ? "1" : "0"
            ]);
        }

        tabAudioRefreshTimer.restart();
        return true;
    }

    function scheduleWindowAudioProbe() {
        windowAudioAvailable = false;
        windowAudioMuted = false;
        windowAudioPolicyActive = false;
        windowAudioSinkInputs = [];
        windowAudioProbeWindowKey = "";

        if (!menuOpen || !selectedResultIsWindow())
            return;

        const entry = selectedResult();

        windowAudioAvailable = true;
        windowAudioPolicyActive =
            windowMutePolicyActiveFor(entry);
        windowAudioMuted =

                : appControlWindow.selectedModeIndex
                  === appControlWindow.thermalModeIndex
                ? thermalViewSelector.height
                : appControlWindow.selectedModeIndex
                  === appControlWindow.killModeIndex
                ? killGlobalSelector.height
                : 0
            anchors.bottomMargin:
                appControlWindow.selectedModeIndex
                === appControlWindow.favoritesModeIndex
                ? favoritesBottomSubmodes.height + 4
                : appControlWindow.selectedModeIndex
                  === appControlWindow.runModeIndex
                ? runPrefixSelector.height + 4
                : appControlWindow.selectedModeIndex
                  === appControlWindow.appsModeIndex
                ? appLaunchSelector.height + 4
                : appControlWindow.selectedModeIndex
                  === appControlWindow.killModeIndex
                ? killBottomActionSelector.height + 4
                : 4
            anchors.rightMargin: 3

            color:
                appControlWindow.selectedModeIndex
                === appControlWindow.thermalModeIndex
                ? Colors.orange
                : appControlWindow.selectedModeIndex
                  === appControlWindow.killModeIndex
                ? Colors.red
                : Colors.cyan

            opacity: resultList.contentHeight > resultList.height ? 0.9 : 0.0
            visible: opacity > 0.0

            z: 300

            property real maxContentY: Math.max(
                0,
                resultList.contentHeight - resultList.height
            )

            property real handleTravel: Math.max(
                0,
                height - resultScrollHandle.height
            )

            function setScrollFromHandleY(handleY) {
                if (maxContentY <= 0 || handleTravel <= 0)
                    return;

                const clampedY = Math.max(
                    0,
                    Math.min(handleTravel, handleY)
                );

                resultList.contentY =
                    (clampedY / handleTravel) * maxContentY;
            }

            Rectangle {
                id: resultScrollHandle

                width: 6
                anchors.horizontalCenter: parent.horizontalCenter

                height: Math.max(
                    30,
                    parent.height * Math.min(
                        1.0,
                        resultList.visibleArea.heightRatio
                    )
                )

                y: {
                    if (resultScrollTrack.maxContentY <= 0
                            || resultScrollTrack.handleTravel <= 0)
                        return 0;

                    const clampedContentY = Math.max(
                        0,
                        Math.min(
                            resultScrollTrack.maxContentY,
                            resultList.contentY
                        )
                    );

                    return (clampedContentY / resultScrollTrack.maxContentY)
                            * resultScrollTrack.handleTravel;
                }

                color:
                    appControlWindow.selectedModeIndex
                    === appControlWindow.thermalModeIndex
                    ? Colors.magenta
                    : appControlWindow.selectedModeIndex
                      === appControlWindow.killModeIndex
                    ? Colors.magenta
                    : Colors.magenta

                RectangularShadow {
                    anchors.fill: parent

                    spread: 2
                    z: -1

                    opacity: 0.16
                    color: resultScrollHandle.color
                }
            }

            MouseArea {
                id: resultScrollMouse

                anchors.fill: parent

                hoverEnabled: true
                acceptedButtons: Qt.LeftButton

                property real dragOffset: 0

                onPressed: function(mouse) {
                    const handleTop = resultScrollHandle.y;
                    const handleBottom =
                        resultScrollHandle.y + resultScrollHandle.height;

                    if (mouse.y >= handleTop && mouse.y <= handleBottom) {
                        // Dragging directly from the magenta handle.
                        dragOffset = mouse.y - resultScrollHandle.y;
                    } else {
                        // Clicking the cyan track jumps the handle toward
                        // that location and immediately allows dragging.
                        dragOffset = resultScrollHandle.height / 2;
                        resultScrollTrack.setScrollFromHandleY(
                            mouse.y - dragOffset
                        );
                    }

                    mouse.accepted = true;
                }

                onPositionChanged: function(mouse) {
                    if (!pressed)
                        return;

                    resultScrollTrack.setScrollFromHandleY(
                        mouse.y - dragOffset
                    );
                }

                onWheel: function(wheel) {
                    // Wheel/trackpad scrolling still belongs to the ListView.
                    wheel.accepted = false;
                }
            }
        }
    }

    // Per-action lock for session-critical TASK MANAGER targets. Each lock is
    // keyed to the selected process identity; it never unlocks another process.
    // Left click = one-shot unlock (☍ glyph); right click = sticky unlock (tiny key). The magenta
    // master lock in PROCESS STATE supersedes all three.
    Component {
        id: taskActionSafetyLockComponent

        Item {
            id: taskActionSafetyLockRoot
            anchors.fill: parent

            property var taskItem: null
            property string actionKind: ""
            property color accentColor: Colors.red
            readonly property bool isValidTarget:
                taskItem && Number(taskItem.pid || 0) > 1
            readonly property bool isProtected:
                isValidTarget && appControlWindow.taskRequiresDangerUnlock(taskItem)
            readonly property bool masterUnlocked:
                isValidTarget && appControlWindow.taskDangerUnlocked(taskItem)
            readonly property bool unlocked:
                isValidTarget
                && appControlWindow.taskDangerActionUnlocked(taskItem, actionKind)
            readonly property bool stickyUnlocked:
                isValidTarget
                && appControlWindow.taskDangerActionStickyUnlocked(taskItem, actionKind)

            visible: isValidTarget && isProtected

            Rectangle {
                id: taskActionSafetyLockPlate
                anchors.fill: parent
                anchors.margins: 3
                color: Colors.black
                opacity: 0.92
                border.width: 1
                border.color: taskActionSafetyLockRoot.accentColor
            }

            RectangularShadow {
                anchors.fill: taskActionSafetyLockPlate
                anchors.margins: -4
                spread: 4
                z: -1
                opacity:
                    taskActionSafetyLockMouse.containsMouse
                    ? 0.38
                    : taskActionSafetyLockRoot.unlocked ? 0.25 : 0.15
                color: taskActionSafetyLockRoot.accentColor
            }

            GohuText {
                anchors.centerIn: parent
                text:
                    taskActionSafetyLockRoot.stickyUnlocked
                    ? ""
                    : taskActionSafetyLockRoot.unlocked ? "☍" : ""
                font.pixelSize: taskActionSafetyLockRoot.stickyUnlocked ? 15 : 12
                color: taskActionSafetyLockRoot.accentColor
                layer.enabled: true
                layer.effect: DropShadow {
                    radius: 5
                    samples: 5
                    opacity: 0.30
                    color: taskActionSafetyLockRoot.accentColor
                    transparentBorder: true
                }
            }

            MouseArea {
                id: taskActionSafetyLockMouse
                anchors.fill: parent
                enabled:
                    taskActionSafetyLockRoot.isValidTarget
                    && !taskActionSafetyLockRoot.masterUnlocked
                hoverEnabled: true
                acceptedButtons: Qt.LeftButton | Qt.RightButton
                onClicked: function(mouse) {
                    mouse.accepted = true;
                    if (mouse.button === Qt.RightButton)
                        appControlWindow.toggleTaskDangerActionStickyUnlock(
                            taskActionSafetyLockRoot.taskItem,
                            taskActionSafetyLockRoot.actionKind
                        );
                    else
                        appControlWindow.toggleTaskDangerActionUnlock(
                            taskActionSafetyLockRoot.taskItem,
                            taskActionSafetyLockRoot.actionKind
                        );
                }
            }
        }
    }

    // Shared APP/WINDOW/TAB resource controls. The same LIMIT geometry is
    // loaded into each control section so interaction remains consistent.
    Component {
        id: resourceLimitControlComponent

        Rectangle {
            id: resourceLimitControlRoot
            anchors.fill: parent
            color: Colors.black
            border.width: 1
            border.color:
                keyboardSelected ? Colors.magenta : Colors.yellow

            readonly property bool keyboardSelected:
                appControlWindow.detailFocused
                && appControlWindow.selectedDetailActionIndex === -2

            property real previewPercent: -1
            property bool editingValue: false
            readonly property bool canAdjust:
                appControlWindow.selectedResourceLimitAvailable()
            readonly property real activePercent:
                previewPercent >= 0
                ? previewPercent
                : appControlWindow.selectedResourceLimitPercent()
            readonly property real handleWidth: 22
            readonly property real handleHalfWidth: handleWidth / 2
            readonly property real trackStartX: resourceLimitPlate.x + resourceLimitPlate.width + 6
            readonly property real trackSpan:
                Math.max(handleWidth + 1, width - trackStartX - 4)
            readonly property real dragSpan: Math.max(1, trackSpan - handleWidth)
            readonly property real handleCenterMinX: trackStartX + handleHalfWidth

            opacity: canAdjust ? 1.0 : 0.42

            function percentAt(positionX) {
                return Math.max(0, Math.min(100,
                    ((positionX - handleCenterMinX) / dragSpan) * 100
                ));
            }

            function keyboardStep(deltaPercent) {
                if (!canAdjust)
                    return;

                const next = Math.max(
                    0,
                    Math.min(100, activePercent + Number(deltaPercent || 0))
                );

                previewPercent = -1;
                appControlWindow.setSelectedResourceMemoryLimitPercent(next);
            }

            function commitEditorValue() {
                if (!editingValue)
                    return;

                const value = Number(resourceLimitEditor.text);
                if (isFinite(value) && value > 0)
                    appControlWindow.setSelectedResourceMemoryLimitMiB(value);

                previewPercent = -1;
                editingValue = false;
            }

            Rectangle {
                anchors.left: parent.left
                anchors.leftMargin: parent.trackStartX
                anchors.top: parent.top
                anchors.bottom: parent.bottom
                anchors.topMargin: 3
                anchors.bottomMargin: 3
                width: Math.max(0, parent.trackSpan * parent.activePercent / 100)
                color: Colors.yellow
                opacity: 0.52
                layer.enabled: true
                layer.effect: DropShadow {
                    radius: 6
                    samples: 7
                    opacity: 0.44
                    color: Colors.yellow
                    transparentBorder: true
                }
            }

            Rectangle {
                id: resourceLimitHandle
                z: 5
                width: parent.handleWidth
                height: parent.height - 4
                y: 2
                x: parent.trackStartX + parent.dragSpan * parent.activePercent / 100
                color: Colors.white
                border.width: 1
                border.color: Colors.yellow

                GohuText {
                    anchors.centerIn: parent
                    text: "▮"
                    font.pixelSize: 12
                    color: Colors.black
                }

                RectangularShadow {
                    anchors.fill: parent
                    spread: 3
                    z: -1
                    opacity:
                        resourceLimitMouse.containsMouse
                        || resourceLimitMouse.pressed ? 0.68 : 0.44
                    color: Colors.yellow
                }
            }

            Rectangle {
                id: resourceLimitPlate
                anchors.left: parent.left
                anchors.leftMargin: 4
                anchors.verticalCenter: parent.verticalCenter
                z: 30
                width: 126
                height: parent.height - 8
                color: Colors.black
                opacity: 0.96

                MouseArea {
                    anchors.fill: parent
                    z: 0
                    onClicked: {
                        resourceLimitControlRoot.commitEditorValue();
                        resourceLimitEditor.focus = false;
                        appControlWindow.keyboardActive = false;
                        appControlWindow.modeRailFocused = false;
                        appControlWindow.detailFocused = true;
                        appControlWindow.selectedDetailActionIndex = -2;
                    }
                }

                Row {
                    z: 1
                    anchors.centerIn: parent
                    spacing: 4

                    GohuText {
                        text: "LIMIT"
                        height: resourceLimitPlate.height
                        verticalAlignment: Text.AlignVCenter
                        font.pixelSize: 10
                        color: Colors.yellow
                    }

                    TextInput {
                        id: resourceLimitEditor
                        width: 52
                        height: resourceLimitPlate.height
                        verticalAlignment: TextInput.AlignVCenter
                        horizontalAlignment: TextInput.AlignHCenter
                        text:
                            appControlWindow.selectedResourceLimitMixed()
                            ? "MIX"
                            : appControlWindow.selectedResourceHasLimit()
                              ? String(Math.round(appControlWindow.selectedResourceLimitMiB()))
                              : "∞"
                        color: Colors.white
                        font.pixelSize: 10
                        selectByMouse: true
                        enabled: parent.parent.parent.canAdjust
                        validator: IntValidator {
                            bottom: Math.floor(appControlWindow.selectedResourceLimitMinimumMiB())
                            top: Math.floor(appControlWindow.selectedResourceLimitMaximumMiB())
                        }
                        function returnToLimitNavigation(moveDirection) {
                            parent.parent.parent.commitEditorValue();
                            focus = false;
                            appControlWindow.keyboardActive = true;
                            appControlWindow.modeRailFocused = false;
                            appControlWindow.detailFocused = true;
                            appControlWindow.selectedDetailActionIndex = -2;
                            Qt.callLater(function() {
                                searchInput.forceActiveFocus();
                                if (moveDirection !== 0)
                                    appControlWindow.moveDetailSelection(moveDirection);
                                else
                                    appControlWindow.ensureDetailActionVisible();
                            });
                        }
                        onActiveFocusChanged: {
                            if (activeFocus) {
                                parent.parent.parent.editingValue = true;
                                if (text === "∞" || text === "MIX") {
                                    const current = appControlWindow.selectedResourceLimitMiB();
                                    text = String(Math.round(
                                        current > 0
                                        ? current
                                        : appControlWindow.selectedResourceLimitMaximumMiB()
                                    ));
                                }
                                selectAll();
                            } else {
                                parent.parent.parent.commitEditorValue();
                                appControlWindow.modeRailFocused = false;
                                appControlWindow.detailFocused = true;
                                appControlWindow.selectedDetailActionIndex = -2;
                                Qt.callLater(function() {
                                    if (appControlWindow.menuOpen
                                            && appControlWindow.detailFocused)
                                        searchInput.forceActiveFocus();
                                });
                            }
                        }
                        Keys.onReturnPressed: returnToLimitNavigation(0)
                        Keys.onEnterPressed: returnToLimitNavigation(0)
                        Keys.onEscapePressed: {
                            parent.parent.parent.editingValue = false;
                            focus = false;
                            appControlWindow.modeRailFocused = false;
                            appControlWindow.detailFocused = true;
                            appControlWindow.selectedDetailActionIndex = -2;
                            Qt.callLater(function() { searchInput.forceActiveFocus(); });
                        }
                        Keys.onPressed: function(event) {
                            if (event.key === Qt.Key_Down || event.key === Qt.Key_Up) {
                                returnToLimitNavigation(event.key === Qt.Key_Down ? 1 : -1);
                                event.accepted = true;
                            }
                        }
                    }

                    GohuText {
                        text: "MiB"
                        height: resourceLimitPlate.height
                        verticalAlignment: Text.AlignVCenter
                        font.pixelSize: 9
                        color: Colors.yellow
                        layer.enabled: true
                        layer.effect: DropShadow {
                            radius: 5
                            samples: 5
                            opacity: 0.36
                            color: Colors.yellow
                            transparentBorder: true
                        }
                    }
                }
            }

            MouseArea {
                id: resourceLimitMouse
                anchors.fill: parent
                z: 20
                enabled: parent.canAdjust
                hoverEnabled: true
                preventStealing: true
                acceptedButtons: Qt.LeftButton
                property real dragOffsetX: 0

                onEntered: {
                    appControlWindow.keyboardActive = false;
                    appControlWindow.modeRailFocused = false;
                    appControlWindow.detailFocused = true;
                    appControlWindow.selectedDetailActionIndex = -2;
                }

                onPressed: function(mouse) {
                    if (mouse.x <= resourceLimitPlate.x + resourceLimitPlate.width) {
                        mouse.accepted = false;
                        return;
                    }
                    resourceLimitControlRoot.commitEditorValue();
                    resourceLimitEditor.focus = false;
                    appControlWindow.selectedDetailActionIndex = -2;
                    const center = resourceLimitHandle.x + resourceLimitHandle.width / 2;
                    const over = mouse.x >= resourceLimitHandle.x
                                 && mouse.x <= resourceLimitHandle.x + resourceLimitHandle.width;
                    dragOffsetX = over ? mouse.x - center : 0;
                    parent.previewPercent = parent.percentAt(mouse.x - dragOffsetX);
                    mouse.accepted = true;
                }
                onPositionChanged: function(mouse) {
                    if (pressed && mouse.x > resourceLimitPlate.x + resourceLimitPlate.width)
                        parent.previewPercent = parent.percentAt(mouse.x - dragOffsetX);
                }
                onReleased: function(mouse) {
                    if (parent.previewPercent >= 0)
                        appControlWindow.setSelectedResourceMemoryLimitPercent(parent.previewPercent);
                    parent.previewPercent = -1;
                    dragOffsetX = 0;
                    mouse.accepted = true;
                }
                onWheel: function(wheel) {
                    const delta = wheel.angleDelta.y !== 0
                                  ? wheel.angleDelta.y : wheel.pixelDelta.y;
                    const next = Math.max(0, Math.min(100,
                        parent.activePercent + (delta >= 0 ? 2 : -2)
                    ));
                    appControlWindow.setSelectedResourceMemoryLimitPercent(next);
                    wheel.accepted = true;
                }
            }

            RectangularShadow {
                anchors.fill: parent
                anchors.margins: -4
                spread: 4
                z: -1
                opacity: resourceLimitMouse.containsMouse || resourceLimitMouse.pressed ? 0.68 : 0.38
                color: Colors.yellow
            }
        }
    }


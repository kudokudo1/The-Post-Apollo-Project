                        if (mouse.y >= handleTop && mouse.y <= handleBottom)
                            dragOffset = mouse.y - resourceScopeScrollHandle.y;
                        else {
                            dragOffset = resourceScopeScrollHandle.height / 2;
                            resourceScopeScrollTrack.setScrollFromHandleY(
                                mouse.y - dragOffset
                            );

        const samples = Array.isArray(rows) ? rows : [];

        if (samples.length > 0) {
            updateTaskMiniCpuHistories(samples);
            updateTaskMiniHunterMetricHistories(samples);
            taskMiniHistoryRevision += 1;
            taskMiniDisplayRevision += 1;
        }
    }


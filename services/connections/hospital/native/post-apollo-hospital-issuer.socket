# Source-only candidate. Do NOT install/enable until operator-approved root custody,
# dedicated PX writer, effective Polkit rules and signer release provenance exist.
[Unit]
Description=Post Apollo Hospital Room native authorization socket

[Socket]
ListenSequentialPacket=/run/post-apollo/hospital/issuer.sock
Accept=no
SocketUser=root
SocketGroup=postapollo-hospital-clients
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Service=post-apollo-hospital-issuer.service

# Deliberately no [Install] section; the operator must separately approve.

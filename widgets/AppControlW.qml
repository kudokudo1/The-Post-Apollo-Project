                                    ? (firing ? "₍˄×⚇×˄₎ " : "₍˄·͈⚇·͈˄₎ ")
                                    : killBottomButton.modelData.key === "mice"
                                      ? (firing ? "(ᐢ××ᐢ)౨ " : "(ᐢ..ᐢ)౨ ")
                                      : "";

                                if (killBottomButton.modelData.key === "all") {

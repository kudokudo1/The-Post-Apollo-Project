    function scheduleAppAudioProbe() {
        appAudioSinkInputs = [];
        appAudioAvailable = false;
        appAudioMuted = false;
        appAudioProbeAppKey = "";
        appAudioVolumePercent = 100;

        if (!menuOpen || !selectedResultIsApplication())
            return;

        const entry = favoriteSourceItem(selectedResult()) || selectedResult();
        if (!entry || entry._hiddenCommand)
            return;

        // Resolve the selected app's own remembered value before checking
        // whether it currently has a window/audio stream. This prevents an
        // unavailable app from displaying the previously selected app's level.
        const desiredVolume = appVolumePolicyPercentFor(entry);
        appAudioVolumePercent = desiredVolume >= 0 ? desiredVolume : 100;

        const windows = selectedAppWindows || [];
        if (windows.length === 0)
            return;

        appAudioAvailable = true;
        appAudioProbeAppKey = appEntryKey(entry);

        appAudioMuted = appMutePolicyActiveFor(entry);
        appAudioProbeTimer.restart();

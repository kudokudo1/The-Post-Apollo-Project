                Rectangle {
                    id: appVolumeSlider

                    visible: appMuteAction.visible
                    width: parent.width - 10
                    height: 32
                    anchors.horizontalCenter: parent.horizontalCenter

                    property real previewPercent: -1
                    property string previewAppKey: ""
                    readonly property string currentAppKey:
                        appControlWindow.selectedApplicationAudioKey()
                    readonly property bool canAdjust:
                        appControlWindow.appAudioAvailable

                    readonly property real trackStartX:
                        appVolumeSliderValueTextPlate.x + appVolumeSliderValueTextPlate.width + 6
                    readonly property real trackEndMargin: 4
                    readonly property real handleWidth: 24
                    readonly property real handleHalfWidth: handleWidth / 2
                    readonly property real trackSpan:
                        Math.max(handleWidth + 1,
                                 width - trackStartX - trackEndMargin)
                    readonly property real dragSpan:
                        Math.max(1, trackSpan - handleWidth)
                    readonly property real handleCenterMinX:
                        trackStartX + handleHalfWidth

                    function activePercent() {
                        return previewPercent >= 0
                               && previewAppKey === currentAppKey
                               ? previewPercent
                               : appControlWindow.appAudioVolumePercent;
                    }

                    function percentAt(positionX) {
                        // Value coordinates are based on the HANDLE CENTER,
                        // not the whole painted track. This keeps the pointer
                        // and thumb on the same coordinate system and prevents
                        // the jump/jitter that occurred when drag began.
                        return Math.max(0, Math.min(appControlWindow.audioVolumeMaxPercent,
                            ((positionX - handleCenterMinX) / dragSpan)
                            * appControlWindow.audioVolumeMaxPercent));
                    }

                    readonly property bool keyboardSelected:
                        appControlWindow.detailFocused
                        && appControlWindow.selectedDetailActionIndex === -3

                    function keyboardStep(deltaPercent) {
                        if (!canAdjust)
                            return;
                        const target = Math.max(
                            0,
                            Math.min(
                                appControlWindow.audioVolumeMaxPercent,
                                activePercent() + Number(deltaPercent || 0)
                            )
                        );
                        previewAppKey = currentAppKey;
                        previewPercent = target;
                        appControlWindow.setSelectedApplicationVolume(target);
                        appVolumePreviewReset.restart();
                    }


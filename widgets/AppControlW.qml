             + "            except Exception:\n"
             + "                name = \"\"\n"
             + "            names.append(name)\n"
             + "        return iface, names\n"
             + "\n"
             + "    def invoke(obj, wanted=None):\n"
             + "        iface, names = action_names(obj)\n"

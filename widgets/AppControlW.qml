             + "                exact=True,\n"
             + "                search_all=True,\n"
             + "                timeout=1.5\n"
             + "            ):\n"
             + "                ok = wait_click_named(\n"
             + "                    [\"Reopen closed tab\"],\n"
             + "                    exact=False,\n"
             + "                    search_all=True,\n"
             + "                    timeout=2.0\n"
             + "                )\n"
             + "\n"
             + "    elif kind == \"task-manager\":\n"
             + "        if open_main_menu():\n"
             + "            # Some versions expose Task manager directly; most place it under\n"
             + "            # More tools. Polling avoids racing Brave's popup animation.\n"
             + "            ok = wait_click_named(\n"
             + "                [\"Task manager\"],\n"
             + "                exact=False,\n"
             + "                search_all=True,\n"
             + "                timeout=0.45\n"
             + "            )\n"
             + "\n"
             + "            if not ok and wait_click_named(\n"
             + "                [\"More tools\"],\n"
             + "                exact=False,\n"
             + "                search_all=True,\n"
             + "                timeout=1.8\n"
             + "            ):\n"
             + "                ok = wait_click_named(\n"
             + "                    [\"Task manager\"],\n"
             + "                    exact=False,\n"
             + "                    search_all=True,\n"
             + "                    timeout=2.0\n"
             + "                )\n"
             + "\n"
             + "    else:\n"
             + "        raise RuntimeError(\"unknown Brave browser action\")\n"
             + "\n"
             + "    if not ok:\n"
             + "        raise RuntimeError(\n"
             + "            \"Brave menu opened, but the requested action was not exposed in time\"\n"
             + "        )\n"
             + "\n"
             + "except Exception as exc:\n"
             + "    notify(\"Browser action failed: \" + str(exc))\n";
    }
    function runBraveLaunchAction(kind, entry) {
        const tokens = appLaunchCommandTokens(entry);
        let extra = [];

        if (kind === "history")
            // Do not combine the internal history URL with --new-window.
            // Brave can accept the hand-off but ignore the URL and merely
            // focus/open a blank tab. Hand the history URL directly to the
            // already-running browser process instead.
            extra = ["brave://history/"];
        else if (kind === "new-window")
            extra = ["--new-window", "brave://newtab/"];
        else if (kind === "new-private-window")
            extra = ["--incognito", "--new-window", "brave://newtab/"];
        else
            return false;

        if (tokens.length > 0 && tokens[0] !== "__APPCONTROL_SHELL__") {
            Quickshell.execDetached(tokens.concat(extra));
            return true;
        }

        // Fallback for unusual desktop entries whose Exec line required the
        // shell parser. Native/RPM Brave normally takes the branch above.
        const quotedExtra = extra.map(function(part) {
            return "'" + String(part).replace(/'/g, "'\\''") + "'";
        }).join(" ");

        Quickshell.execDetached([
            "/bin/sh", "-lc",
            "exe=$(command -v brave-browser || command -v brave-browser-stable || command -v brave); "
            + "if [ -n \"$exe\" ]; then nohup \"$exe\" " + quotedExtra
            + " >/dev/null 2>&1 </dev/null & fi"
        ]);
        return true;
    }

    function browserFocusCriteria(kind) {
        if (kind === "brave")
            return [
                '[app_id="brave-browser"] focus',
                '[app_id="brave-browser-stable"] focus',
                '[class="Brave-browser"] focus',
                '[class="brave-browser"] focus'
            ];
        if (kind === "mullvad")
            return [
                '[app_id="mullvad-browser"] focus',
                '[class="Mullvad Browser"] focus',
                '[class="mullvad-browser"] focus'
            ];
        return [
            '[app_id="firefox"] focus',
            '[class="firefox"] focus',
            '[class="Firefox"] focus'
        ];
    }

    function browserShortcutSequence(browserKind, action) {
        if (action === "history")
            return browserKind === "brave"
                   ? ["ctrl", "h"]
                   : ["ctrl", "shift", "h"];
        if (action === "downloads")
            return browserKind === "brave" ? ["ctrl", "j"] : [];
        if (action === "bookmarks")
            return ["ctrl", "shift", "o"];
        if (action === "clear-data")
            return ["ctrl", "shift", "Delete"];
        if (action === "restore" && browserKind === "brave")
            return ["ctrl", "shift", "t"];
        if (action === "task-manager" && browserKind === "brave")
            return ["shift", "Escape"];
        if (action === "devtools")
            return ["F12"];
        return [];
    }

    function runBrowserShortcutAction(browserKind, action) {
        const sequence = browserShortcutSequence(browserKind, action);
        if (sequence.length < 1)
            return false;

        const key = sequence[sequence.length - 1];
        const modifiers = sequence.slice(0, sequence.length - 1);
        const criteria = browserFocusCriteria(browserKind);

        let script = "set -u; ";
        script += "focused=0; ";
        for (let i = 0; i < criteria.length; i++) {
            const q = String(criteria[i]);
            script += "if [ $focused -eq 0 ] && swaymsg '" + q
                    + "' >/dev/null 2>&1; then focused=1; fi; ";
        }
        script += "sleep 0.18; ";
        script += "if command -v wtype >/dev/null 2>&1; then ";
        // IMPORTANT: modifier press, key press/release, and modifier release must
        // happen in ONE wtype process. wtype automatically releases held
        // modifiers when its process exits, so separate invocations turn a
        // Ctrl+Shift+T into a plain T.
        let wtypeCommand = "wtype";
        for (let i = 0; i < modifiers.length; i++)
            wtypeCommand += " -M " + modifiers[i];
        wtypeCommand += " -k '" + String(key) + "'";
        for (let i = modifiers.length - 1; i >= 0; i--)
            wtypeCommand += " -m " + modifiers[i];
        script += wtypeCommand + " >/dev/null 2>&1; ";
        script += "else notify-send 'AppControl • Browser' 'This browser action needs wtype on Sway. Install wtype once; AppControl will use the browser native shortcut after that.' >/dev/null 2>&1 || true; fi";

        Quickshell.execDetached(["/bin/sh", "-lc", script]);
        return true;
    }

    function runBrowserLaunchAction(browserKind, action, entry) {
        const tokens = appLaunchCommandTokens(entry);
        let extra = [];

        if (browserKind === "brave") {
            if (action === "new-window")
                extra = ["--new-window"];
            else if (action === "new-tab")
                extra = ["--new-tab", "brave://newtab/"];
            else if (action === "new-private-window")
                extra = ["--incognito", "--new-window"];
            else if (action === "extensions")
                extra = ["brave://extensions/"];
            else if (action === "settings")
                extra = ["brave://settings/"];
            else
                return false;
        } else {
            if (action === "new-window")
                extra = ["--new-window", "about:newtab"];
            else if (action === "new-tab")
                extra = ["--new-tab", "about:newtab"];
            else if (action === "new-private-window")
                extra = ["--private-window"];
            else if (action === "extensions")
                extra = ["--new-tab", "about:addons"];
            else if (action === "settings")
                extra = ["--preferences"];
            else if (action === "passwords")
                extra = ["--new-tab", "about:logins"];
            else if (action === "profile-manager")
                extra = ["--ProfileManager"];
            else if (action === "firefox-view")
                extra = ["--new-tab", "about:firefoxview"];
            else
                return false;
        }

        if (tokens.length > 0 && tokens[0] !== "__APPCONTROL_SHELL__") {
            Quickshell.execDetached(tokens.concat(extra));
            return true;
        }

        return false;
    }

    function runBrowserBuiltinAppAction(kind, entry) {
        const browserKind = appEntryBrowserKind(entry);
        const action = String(kind || "");
        if (!browserKind)
            return;

        // Native browser shortcuts are preferable for commands that browsers
        // do not expose as a stable external command. wtype talks directly to
        // wlroots' virtual keyboard protocol and does not scrape browser menus.
        if (browserShortcutSequence(browserKind, action).length > 0) {
            runBrowserShortcutAction(browserKind, action);
            return;
        }

        // Firefox/Mullvad destinations can be handed to the running Gecko
        // instance via documented command-line options. Downloads is a stable
        // about: page; settings uses --preferences.
        if (browserKind !== "brave" && action === "downloads") {
            const tokens = appLaunchCommandTokens(entry);
            if (tokens.length > 0 && tokens[0] !== "__APPCONTROL_SHELL__")
                Quickshell.execDetached(tokens.concat(["--new-tab", "about:downloads"]));
            return;
        }

        if (browserKind !== "brave" && action === "bookmarks") {
            runBrowserShortcutAction(browserKind, "bookmarks");
            return;
        }

        if (action === "clear-data") {
            runBrowserShortcutAction(browserKind, action);
            return;
        }

        if (runBrowserLaunchAction(browserKind, action, entry))
            return;

        // Brave's internal settings pages are launchable directly, but History,
        // Downloads and Bookmarks are intentionally routed through native
        // shortcuts above so Chromium cannot silently replace them with a blank
        // focused tab when receiving an external brave:// URL.
        if (browserKind === "brave") {
            if (action === "downloads"
                    || action === "bookmarks"
                    || action === "history") {
                runBrowserShortcutAction(browserKind, action);
                return;
            }
        }
    }

    // Keep the old function name as a compatibility wrapper for any bindings
    // elsewhere in this file that still reference it.
    function runBraveBuiltinAppAction(kind, entry) {
        runBrowserBuiltinAppAction(kind, entry);
    }

    function activateAppTabControl(entry, keepMenuOpen) {
        if (!entry || !entry._tabControlRecord)

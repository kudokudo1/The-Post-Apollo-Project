                    const clampedY = Math.max(0, Math.min(handleTravel, handleY));
                    resourceScopeFlick.contentY =
                        (clampedY / handleTravel) * maxContentY;
                }

                Rectangle {
                    id: resourceScopeScrollHandle
                    width: 5
                    anchors.horizontalCenter: parent.horizontalCenter
                    height: Math.max(
                        18,
                        parent.height * Math.min(
                            1.0,
                            resourceScopeFlick.visibleArea.heightRatio
                        )
                    )

                    y: {
                        if (resourceScopeScrollTrack.maxContentY <= 0
                                || resourceScopeScrollTrack.handleTravel <= 0)
                            return 0;

                        const clampedContentY = Math.max(
                            0,
                            Math.min(
                                resourceScopeScrollTrack.maxContentY,
                                resourceScopeFlick.contentY
                            )
                        );

                        return (clampedContentY / resourceScopeScrollTrack.maxContentY)
                               * resourceScopeScrollTrack.handleTravel;
                    }

                    color: Colors.magenta


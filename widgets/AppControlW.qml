        for (let i = 0; i < raw.length; i++) {
            const value = String(raw[i] || "");
            addToken(value);

            const parts = value.toLowerCase().split(/[^a-z0-9]+/);
            for (let p = 0; p < parts.length; p++) {
                const part = parts[p];

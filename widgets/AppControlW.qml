             + "            )\n"
             + "        except Exception:\n"
             + "            count = 0\n"
             + "        result = []\n"
             + "        for index in range(count):\n"
             + "            try:\n"
             + "                child = atspi.atspi_accessible_get_child_at_index(\n"
             + "                    obj,\n"
             + "                    index,\n"

                    if (mouse.y >= handleTop && mouse.y <= handleBottom) {
                        dragOffset = mouse.y - detailScrollHandle.y;
                    } else {
                        dragOffset = detailScrollHandle.height / 2;

                        detailScrollTrack.setScrollFromHandleY(

    function activateFavoritesSubmode(item) {
        if (!item) return;
        keyboardActive = false;
        if (item.group === "appSource") setAppSourceMode(item.value);
        else if (item.group === "appLaunch") setAppLaunchMode(item.value);
        else if (item.group === "runList") setRunListMode(item.value);
        else if (item.group === "runPrefix") setRunPrefixMode(item.value);
        else if (item.group === "windowList") setWindowListMode(item.value);
        else if (item.group === "thermalView") setThermalViewMode(item.value);
        else if (item.group === "killView") setKillViewMode(item.value);
        else if (item.group === "hunterMetric") setHunterMetricMode(item.value);
        else if (item.group === "hunterVisibility") setHunterVisibilityMode(item.value);

        // The copied controls live inside FAVORITES; setters were originally
        // written for their native mode and may reset selection. Keep focus in
        // FAVORITES and immediately rebuild against the chosen sub-filter.
        Qt.callLater(function() {
            if (selectedModeIndex === favoritesModeIndex) {
                resetResultSelection();
                resetDetailActionSelection();
                searchInput.forceActiveFocus();
            }
        });
    }

    function favoriteEntryMatchesCopiedSubmodes(entry) {
        if (!entry || favoritesFilterMode === favoritesFilterAll)
            return true;

        const source = favoriteSourceItem(entry) || entry;

        if (favoritesFilterMode === appsModeIndex)
            return appEntryMatchesSelectedSource(source);

        if (favoritesFilterMode === runModeIndex) {
            const origin = String(source._runOrigin || "").toUpperCase();
            if (runListMode === runListTerminal && origin !== "TERMINAL")
                return false;
            if (runListMode === runListAll && origin !== "SYSTEM")
                return false;
            if (runListMode === runListUser
                    && (origin === "TERMINAL" || origin === "SYSTEM"))
                return false;
            return normalizeRunPrefixMode(source._runPrefixMode) === runPrefixMode;
        }

        if (favoritesFilterMode === windowsModeIndex)
            return windowListMode === windowListTabs ? !!source._tabRecord : !source._tabRecord;

        if (favoritesFilterMode === thermalModeIndex)
            return thermalViewMode === thermalViewFans
                   ? String(source.sensorKind || "") === "fan"
                   : String(source.sensorKind || "") !== "fan";

        if (favoritesFilterMode === killModeIndex
                && killViewMode === killViewHunter) {
            const live = liveTaskForMiniGraph(entry) || source;
            return hunterTaskActive(live)
                   && hunterTaskClassVisible(live);
        }

        return true;
    }


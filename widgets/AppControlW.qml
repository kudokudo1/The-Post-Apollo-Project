                        // and thumb on the same coordinate system and prevents
                        // the jump/jitter that occurred when drag began.
                        return Math.max(0, Math.min(appControlWindow.audioVolumeMaxPercent,
                            ((positionX - handleCenterMinX) / dragSpan)
                            * appControlWindow.audioVolumeMaxPercent));

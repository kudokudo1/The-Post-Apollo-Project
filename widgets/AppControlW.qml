        if (entry.controlKind === "network" && entry.canReboot)
            return "⚠︎ DISCONNECT MAY DROP NETWORK • REBOOT RESTARTS PC";

        if (entry.controlKind === "network")
            return "⚠︎ DISCONNECT MAY DROP NETWORK";


            Math.max(0, Math.min(audioVolumeMaxPercent, Number(percent || 0)));

        setWindowVolumePolicy(entry, windowAudioVolumePercent);
        setSinkInputVolumes(windowAudioSinkInputs, windowAudioVolumePercent);
        windowAudioRefreshTimer.restart();
    }

    function setSelectedApplicationVolume(percent) {
        if (!selectedResultIsApplication())
            return;

        const entry = favoriteSourceItem(selectedResult()) || selectedResult();
        const windows = selectedAppWindows || [];
        if (!entry || windows.length === 0)
            return;

        appAudioVolumePercent =
            Math.max(0, Math.min(audioVolumeMaxPercent, Number(percent || 0)));

        setAppVolumePolicy(entry, windows, appAudioVolumePercent);
        setSinkInputVolumes(appAudioSinkInputs, appAudioVolumePercent);

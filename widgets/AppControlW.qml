    readonly property int thermalViewThermal: 0
    readonly property int thermalViewFans: 1
    property int thermalViewMode: thermalViewThermal

    // KILL mode now mirrors the other multi-view modes: NORMAL is the full
    // process list, while HUNTER surfaces only recently active processes and
    // ranks them by recent graph pressure.
    readonly property int killViewNormal: 0
    readonly property int killViewHunter: 1
    property int killViewMode: killViewNormal

    // KILL view changes touch the filtered ScriptModel, the ListView delegates,
    // the detail graph and the lower action strip at the same time.  Keep the
    // switch outside the originating MouseArea/key event and hold selection/
    // graph probes until the new model has had one event-loop turn to settle.
    // This avoids delegate/model re-entrancy during NORMAL <-> HUNTER changes.
    property bool killViewSwitchPending: false
    property int killViewRequestedMode: killViewNormal
    property int killViewSwitchSerial: 0

    // A NORMAL <-> HUNTER change reorders many of the exact same JS objects.
    // Quickshell ScriptModel turns that into rowsMoved(), and Qt 6.11's
    // QQmlDelegateModel can crash while a ListView is consuming those moves.
    // Blank the KILL ScriptModel for one event-loop turn so the transition is
    // represented as remove-all -> insert-new instead of a move storm.
    property bool killTaskModelBlank: false

    // Keep the visible KILL order independent from the 600 ms telemetry refresh.
    // ScriptModel emits rowsMoved() when the same identities change order; the
    // first native crash landed exactly in QQmlDelegateModel::_q_itemsMoved().
    // Existing tasks therefore keep their presentation slot until an explicit
    // NORMAL/HUNTER/filter change rebuilds the ranking while the model is blank.
    property var killTaskOrderIds: []

    function killTaskVisibleForView(entry, viewMode) {
        if (!entry)
            return false;

        if (viewMode === killViewHunter)
            return hunterTaskActive(entry) && hunterTaskClassVisible(entry);

        return true;
    }

    function killTaskRankCompare(a, b, viewMode) {
        if (viewMode === killViewHunter) {
            const hunterDelta =
                hunterTaskMetricScore(b) - hunterTaskMetricScore(a);
            if (Math.abs(hunterDelta) > 0.001)
                return hunterDelta;
        }

        const cpuDelta = Number(b.cpu || 0) - Number(a.cpu || 0);
        if (Math.abs(cpuDelta) > 0.001)
            return cpuDelta;

        const memDelta = Number(b.mem || 0) - Number(a.mem || 0);
        if (Math.abs(memDelta) > 0.001)
            return memDelta;

        return Number(a.pid || 0) - Number(b.pid || 0);
    }

    function rebuildKillTaskOrderSnapshot(viewMode) {
        const mode =
            viewMode === killViewHunter ? killViewHunter : killViewNormal;

        const rows = taskRows.filter(function(entry) {
            return killTaskVisibleForView(entry, mode);
        });

        rows.sort(function(a, b) {
            return killTaskRankCompare(a, b, mode);
        });

        killTaskOrderIds = rows.map(function(entry) {
            return String(entry.id || ("task:" + String(entry.pid || 0)));
        });
    }

    function appendNewKillTaskOrderIds(rows) {
        const source = Array.isArray(rows) ? rows : [];
        const known = ({});

        for (let i = 0; i < killTaskOrderIds.length; i++)
            known[String(killTaskOrderIds[i])] = true;

        const additions = source.filter(function(entry) {
            if (!killTaskVisibleForView(entry, killViewMode))
                return false;

            const id = String(entry.id || ("task:" + String(entry.pid || 0)));
            return !known[id];
        });

        if (additions.length === 0)
            return;

        // New processes append deterministically. Existing rows never move just
        // because live CPU/MEM/I/O values changed.
        additions.sort(function(a, b) {
            return Number(a.pid || 0) - Number(b.pid || 0);
        });

        const next = killTaskOrderIds.slice();
        for (let i = 0; i < additions.length; i++) {
            const id = String(
                additions[i].id || ("task:" + String(additions[i].pid || 0))
            );
            if (!known[id]) {
                known[id] = true;
                next.push(id);
            }
        }

        killTaskOrderIds = next;
    }

    // HUNTER answers two separate questions with explicit, visible filters:
    //   metric: what does "large" mean?
    //   visibility: which safety class of processes is being inspected?
    readonly property int hunterMetricCombined: 0
    readonly property string hunterCombiIcon: "°⋆ꙮ๋࣭⭑."
    readonly property int hunterMetricCpu: 1
    readonly property int hunterMetricMemory: 2
    readonly property int hunterMetricIo: 3
    readonly property int hunterMetricAge: 4
    property int hunterMetricMode: hunterMetricCombined

    readonly property int hunterVisibilityTargets: 0
    readonly property int hunterVisibilityProtected: 1
    readonly property int hunterVisibilityAll: 2
    property int hunterVisibilityMode: hunterVisibilityTargets

    function beginKillPresentationChange(kind, value) {
        keyboardActive = true;
        hoveredResultIndex = -1;
        detailFocused = false;

        const targetView =
            kind === "view"
            ? (value === killViewHunter ? killViewHunter : killViewNormal)
            : killViewMode;
        const targetMetric =
            kind === "metric"
            ? Math.max(
                  hunterMetricCombined,
                  Math.min(hunterMetricAge, Number(value || 0))
              )
            : hunterMetricMode;
        const targetVisibility =
            kind === "visibility"
            ? Math.max(
                  hunterVisibilityTargets,
                  Math.min(hunterVisibilityAll, Number(value || 0))
              )
            : hunterVisibilityMode;

        if (!killViewSwitchPending
                && targetView === killViewMode
                && targetMetric === hunterMetricMode
                && targetVisibility === hunterVisibilityMode) {
            resetDetailActionSelection();
            return;
        }

        const preservedPresentationPid =
            selectedResultIsTask()
            ? Number(selectedTask() && selectedTask().pid || 0)
            : 0;

        killViewRequestedMode = targetView;
        killViewSwitchPending = true;
        killViewSwitchSerial += 1;
        const serial = killViewSwitchSerial;

        // Do not mutate/re-rank ScriptModel in the originating input event.
        Qt.callLater(function() {
            if (serial !== appControlWindow.killViewSwitchSerial)
                return;

            appControlWindow.taskRestoringSelection = true;
            appControlWindow.selectedResultIndex = -1;
            appControlWindow.resetDetailActionSelection();

            // Empty first. This converts an otherwise-dangerous move/reorder
            // sequence into remove-all -> property changes -> insert-final-order.
            appControlWindow.killTaskModelBlank = true;

            Qt.callLater(function() {
                if (serial !== appControlWindow.killViewSwitchSerial)
                    return;

                appControlWindow.killViewMode = targetView;
                appControlWindow.hunterMetricMode = targetMetric;
                appControlWindow.hunterVisibilityMode = targetVisibility;

                appControlWindow.rebuildKillTaskOrderSnapshot(targetView);

                Qt.callLater(function() {
                    if (serial !== appControlWindow.killViewSwitchSerial)
                        return;

                    appControlWindow.killTaskModelBlank = false;

                    Qt.callLater(function() {
                        if (serial !== appControlWindow.killViewSwitchSerial)
                            return;

                        appControlWindow.killViewSwitchPending = false;
                        appControlWindow.taskRestoringSelection = false;

                        if (!appControlWindow.menuOpen
                                || appControlWindow.selectedModeIndex
                                   !== appControlWindow.killModeIndex)
                            return;

                        const count = killTaskResults.values.length;
                        let restoreIndex = count > 0 ? 0 : -1;

                        if (preservedPresentationPid > 0) {
                            for (let i = 0; i < count; i++) {
                                if (Number(killTaskResults.values[i].pid || 0)
                                        === preservedPresentationPid) {
                                    restoreIndex = i;
                                    break;
                                }
                            }
                        }

                        appControlWindow.selectedResultIndex = restoreIndex;

                        if (appControlWindow.selectedResultIndex >= 0)
                            resultList.positionViewAtIndex(
                                appControlWindow.selectedResultIndex,
                                ListView.Beginning
                            );

                        appControlWindow.taskMiniHistoryRevision += 1;
                        appControlWindow.rebindTaskDetailGraph(true);
                    });
                });
            });
        });
    }

    function setKillViewMode(mode) {
        beginKillPresentationChange("view", mode);
    }

    function setHunterMetricMode(mode) {
        beginKillPresentationChange("metric", mode);
    }

    function setHunterVisibilityMode(mode) {
        beginKillPresentationChange("visibility", mode);
    }


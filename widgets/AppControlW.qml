        const processId = Number(props["application.process.id"] || 0);
        const windows = windowsForApp(entry);

        // A stream owned by the exact Sway-window PID is the strongest match.
        for (let i = 0; i < windows.length; i++) {
            const pid = Number(windows[i].pid || 0);

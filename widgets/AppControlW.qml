                        anchors.left: parent.left
                        anchors.leftMargin: parent.trackStartX
                        anchors.top: parent.top
                        anchors.bottom: parent.bottom
                        anchors.topMargin: 3
                        anchors.bottomMargin: 3
                        width: Math.max(0,
                            parent.trackSpan
                            * Math.max(0, Math.min(appControlWindow.audioVolumeMaxPercent, appVolumeSlider.activePercent()))
                            / appControlWindow.audioVolumeMaxPercent)
                        color: Colors.omnitrix
                        opacity: 0.50
                        layer.enabled: true
                        layer.effect: DropShadow {

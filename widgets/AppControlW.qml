                        mouse.accepted = true;
                    }

                    onPositionChanged: function(mouse) {
                        if (pressed)
                            resourceScopeScrollTrack.setScrollFromHandleY(
                                mouse.y - dragOffset
                            );
                    }

                    onWheel: function(wheel) {
                        wheel.accepted = false;
                    }
                }
            }
        }
